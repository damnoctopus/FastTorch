<resources>
    <style name="Base.Theme.FastTorch" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorPrimaryContainer">@color/soft_accent</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondaryContainer">@color/soft_accent</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/outline</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="Theme.FastTorch" parent="Base.Theme.FastTorch" />
    <style name="SectionTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>
    <style name="BodyText">
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/muted</item>
    </style>
</resources>
